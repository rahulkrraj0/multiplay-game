# Replace example secrets with unique random values before starting.
POSTGRES_USER=multiplay
POSTGRES_DB=multiplay
POSTGRES_PASSWORD=replace_with_random_alphanumeric_secret

# Local Docker Desktop defaults. Set both URLs to your HTTPS domain for public hosting.
VITE_PUBLIC_SITE_URL=
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Local-only TURN defaults. For public access, use a DNS-only TURN hostname,
# your public IPv4, and TURN URLs for that hostname (see README.md).
TURN_HOSTNAME=localhost
TURN_EXTERNAL_IP=127.0.0.1
TURN_BIND_IP=127.0.0.1
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_SHARED_SECRET=replace_with_a_different_random_secret

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Configure > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=
